# Copy to .env and fill in. Never commit .env.

# --- General ---
DB_PATH=data/agent.db
KB_DIR=kb
COMPANY_NAME=Nordlicht Language School
COMPANY_NAME_DE=Nordlicht Sprachschule
# 1 = local emulator at /demo (turn off in production)
DEMO_MODE=1

# --- Retrieval (local, free) ---
# auto = embeddings + reranker if sentence-transformers is installed, else BM25 keyword search
# (rerank | embeddings | bm25 to force one)
RETRIEVER=auto
EMBED_MODEL=intfloat/multilingual-e5-small
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# 0 = default threshold of the backend; below it the bot hands over to a manager
MIN_SCORE=0

# --- Answers ---
# Empty = template answers (quote + source). Set a key to let Claude phrase answers from the same sources.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Managers (hot leads + questions the bot could not answer) ---
# "<channel>:<id>", comma separated; WhatsApp id = phone number without +
MANAGER_IDS=whatsapp:4915112345678
HOT_LEAD_MIN_BUDGET=250

# --- WhatsApp Cloud API (Meta, official) ---
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=choose-a-random-string
WA_APP_SECRET=
WA_API_VERSION=v23.0
# approved utility template used when the manager's 24 h window is closed
WA_ALERT_TEMPLATE=manager_alert
